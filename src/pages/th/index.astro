---
import config_json from "../../review_templates/template_th.json";
import PageLayout from "../../layouts/PageLayout.astro";
import OptionForm from "../../components/OptionForm.astro";
import FlagSelect from "../../components/FlagSelect.astro";
---

<PageLayout title="Steam Review Template">
  <header class="bg-slate-700 text-white py-2 flex flex-col items-center">
    <h1>{"---{ Review Template }---"}</h1>
    <FlagSelect />
    <p class="mt-0">☑ อย่างแจ่ม</p>
  </header>

  <div class="max-w-screen-sm mx-auto px-4">
    <p>
      นี่เป็นเครื่องมือช่วยสร้าง Steam reviews แบบ คัดลอก-วาง (หากคุณพบหน้านี้ <em>นี่แหละ</em> คือสิ่งที่คุณตามหา
      เราคิดว่ามันสนุกดี จึงสร้างเว็บไซต์นี้ขึ้น เพื่อที่จะได้ไม่ต้อง คัดลอก-วาง ด้วยตนเอง &nbsp;😆
    </p>
    <p>
      โคดนี้เป็นแบบ open source &rarr; <a
        href="https://github.com/VojtaStruhar/steam-review-template"
      >
        ตามไปดูบน GitHub</a
      >!
    </p>
    <p>
      ผลจากการสร้างจะมีการให้เครดิตถึงเรา
      สามารถตัดออกได้ แต่หากแสดงไว้จะขอบคุณมาก!
    </p>
    {
      config_json.categories.map((category, index) => (
        <OptionForm category={category} index={index} />
      ))
    }
    <div class="flex justify-center">
      <button
        id="output-button"
        class="py-4 px-8 text-lg font-bold rounded-lg border-none shadow bg-amber-400 hover:cursor-pointer hover:shadow-lg transition-all"
      >
        สร้าง Steam Review!</button
      >
    </div>

    <div class="flex justify-center mt-4">
      <button
        id="copy-output"
        class="py-2 px-4 text-lg rounded-lg border-none shadow bg-sky-100 hover:cursor-pointer hover:shadow-lg transition-all"
      >
        คัดลอกผล</button
      >
    </div>
  </div>
</PageLayout>
